# Alager Site — Environment Variables
# Copy to .env.local and fill in the values with your credentials

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-06-25
SANITY_API_TOKEN=your_api_token_here
# Viewer token for visual editing / live preview (read-only; role: Viewer)
SANITY_API_READ_TOKEN=
# Secret p/ validar o webhook de revalidação do Sanity (defina o mesmo valor no webhook do painel)
# Sem ele, o webhook /api/sanity/webhook aceita qualquer POST. next-sanity cacheia queries
# indefinidamente e depende desse webhook p/ conteúdo novo aparecer sem redeploy.
SANITY_REVALIDATE_SECRET=
# Anthropic (Claude) — usado pelo scripts/classify-whatsapp.ts para gerar resumo+tema automático dos itens
ANTHROPIC_API_KEY=
# (opcional) modelo Claude; default claude-sonnet-4-5
ANTHROPIC_MODEL=claude-sonnet-4-5
# Public site URL (used by Presentation Tool preview, draft mode redirect AND SEO: canonical/OG/sitemap/hreflang)
# In production (Vercel) set this to the real domain, e.g. https://alager-site.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Deploy token for manual `sanity deploy --external` (Canvas only; grant: deployStudio)
SANITY_AUTH_TOKEN=

# n8n webhook (for associe-se form)
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/alager-join

# Hostinger Reach (newsletter subscribe — create token at https://hpanel.hostinger.com/profile/api)
HOSTINGER_API_TOKEN=
# Optional: Reach tag UUID to segment subscribers into a list
HOSTINGER_TAG_UUID=

# Vercel
VERCEL_URL=

# Analytics (PostHog)
# Chave pública do projeto PostHog (obrigatória p/ ativar analytics; sem ela, o PostHog não inicializa)
NEXT_PUBLIC_POSTHOG_KEY=
# Host do PostHog (default: https://us.i.posthog.com — ajuste p/ .eu se o projeto for EU)
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
